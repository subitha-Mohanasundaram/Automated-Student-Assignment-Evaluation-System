# Copy to .env and fill values. This file is read by web_app.py, worker.py, and MCP server.

# Enable real AI problem generation and feedback.
AI_PROVIDER=openai
OPENAI_MODEL=gpt-5
# OPENAI_API_KEY=sk-...

# Worker tuning
WORKER_POLL_S=1.0
AI_GEN_RETRIES=3

# Demo auth (optional)
DEMO_AUTH=1
INSTRUCTOR_PASSWORD=Teach@123

# MCP server binding (optional)
MCP_HOST=127.0.0.1
MCP_PORT=8000\n\n# Daily auto-assign (worker-driven)\nDAILY_ASSIGN_ENABLED=0\nDAILY_ASSIGN_AT_UTC=07:00\nDAILY_ASSIGN_SOURCES=leetcode,geeksforgeeks,neetcode,hackerearth\nDAILY_ASSIGN_CATALOG_DIR=problems/sources\nDAILY_ASSIGN_STATE_FILE=results/auto_assign_state.json\n
